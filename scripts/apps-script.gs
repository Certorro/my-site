/**
 * Альтер-Эго — приём заявок с сайта.
 *
 * ЭТО КОД ДЛЯ GOOGLE APPS SCRIPT, а не для сайта. Он живёт в вашем
 * Google-аккаунте; в репозитории лежит копия, чтобы серверная и клиентская
 * части менялись согласованно и было видно, что именно развёрнуто.
 *
 * ЗАЧЕМ. Прежний обработчик просто дописывал строку и ничего не отвечал.
 * Сайт слал запрос в режиме no-cors, ответ был непрозрачен, и отличить
 * доставку от потери было нельзя в принципе — поэтому модалка «Заявка
 * отправлена» показывалась всегда, даже когда отправка провалилась.
 * Здесь обработчик отвечает читаемым JSON, и сайт показывает успех
 * только по подтверждению.
 *
 * ────────────────────────────────────────────────────────────────────
 * КАК РАЗВЕРНУТЬ
 *
 *   1. Откройте таблицу с заявками → Расширения → Apps Script.
 *   2. Замените весь код этим файлом.
 *   3. При необходимости укажите NOTIFY_TO ниже (по умолчанию письма
 *      уходят на аккаунт, под которым запущен скрипт, — это безопасно).
 *   4. ВАЖНО: выберите в списке функций doGet и нажмите «Выполнить».
 *      Google запросит разрешения — их нужно выдать. Скрипт теперь шлёт
 *      письмо о заявке, а это новое разрешение по сравнению с прежней
 *      версией; без него уведомления молча не будут уходить.
 *   5. Развернуть → Управление развёртываниями → изменить активное
 *      развёртование → Версия: «Новая» → Развернуть.
 *      Менять существующее развёртывание, а не создавать новое, — иначе
 *      изменится URL и сайт продолжит слать заявки по старому.
 *   6. Проверьте: откройте URL развёртывания в браузере. Должен вернуться
 *      JSON вида {"ok":true,"service":"alter-ego-leads"} — раньше там была
 *      ошибка «Не удалось найти функцию скрипта: doGet».
 *
 * ПОРЯДОК РАСКАТКИ КРИТИЧЕН: сначала обновляется этот скрипт, и только
 * потом публикуется новый сайт. Старый сайт совместим с новым скриптом,
 * поэтому окна, в котором заявки теряются, не возникает. В обратном
 * порядке такое окно будет.
 * ────────────────────────────────────────────────────────────────────
 */

/** Куда слать уведомление о новой заявке.
 *  Пустая строка — на владельца скрипта (ваш Google-аккаунт).
 *  ВНИМАНИЕ: на сайте почта указана по-разному — post@al-e.net на странице
 *  контактов и info@al-e.net в политике конфиденциальности. Впишите сюда
 *  тот ящик, который действительно читают. */
var NOTIFY_TO = '';

/** Не принимать повторную заявку с того же телефона чаще, чем раз в N минут.
 *  Ключ — телефон: IP-адрес клиента Apps Script не отдаёт, поэтому
 *  ограничение по IP здесь невозможно, и притворяться не будем. */
var THROTTLE_MINUTES = 3;

var SERVICE = 'alter-ego-leads';


/** Health-check. Ничего не пишет — нужен, чтобы можно было проверить
 *  доступность и читаемость ответа, не создавая тестовых заявок. */
function doGet() {
  return json({ ok: true, service: SERVICE, ts: new Date().toISOString() });
}


function doPost(e) {
  try {
    var p = (e && e.parameter) || {};

    /* Honeypot: поле скрыто от людей, его заполняют только боты.
       Отвечаем «ок», чтобы бот не подбирал обход. Строка не пишется. */
    if (String(p.website || '').trim() !== '') {
      return json({ ok: true, skipped: 'honeypot' });
    }

    var name  = String(p.name  || '').trim();
    var phone = String(p.phone || '').trim();
    var digits = phone.replace(/\D/g, '');

    if (name.length < 2) {
      return json({ ok: false, error: 'name', message: 'Укажите имя' });
    }
    if (digits.length < 10) {
      return json({ ok: false, error: 'phone', message: 'Укажите телефон' });
    }

    /* Защита от повторов и простого флуда */
    var cache = CacheService.getScriptCache();
    var key = 'lead_' + digits;
    if (cache.get(key)) {
      return json({ ok: false, error: 'throttled',
                    message: 'Заявка с этого номера уже принята. Мы свяжемся с вами.' });
    }
    cache.put(key, '1', THROTTLE_MINUTES * 60);

    var row = [
      new Date(),
      name,
      phone,
      String(p.email   || '').trim(),
      String(p.subject || '').trim(),
      String(p.message || '').trim(),
      String(p.source  || '').trim()
    ];

    var sheet = SpreadsheetApp.getActiveSpreadsheet().getActiveSheet();
    /* У прежнего обработчика было шесть столбцов, добавился «Источник».
       Если лист пуст — подписываем шапку, чтобы столбцы читались. */
    if (sheet.getLastRow() === 0) {
      sheet.appendRow(['Время', 'Имя', 'Телефон', 'E-mail', 'Тема', 'Сообщение', 'Источник']);
    }
    sheet.appendRow(row);
    /* flush — чтобы «ok» ушёл только после фактической записи,
       а не после постановки в очередь. */
    SpreadsheetApp.flush();

    notify(row);

    return json({ ok: true, received: new Date().toISOString() });

  } catch (err) {
    /* Ошибку возвращаем честно: сайт покажет запасной канал связи. */
    return json({ ok: false, error: 'server', message: String(err) });
  }
}


/** Уведомление о новой заявке. Заявка, лежащая в таблице, которую никто
 *  не открывает, эквивалентна потерянной. */
function notify(row) {
  try {
    var to = NOTIFY_TO || Session.getEffectiveUser().getEmail();
    if (!to) return;
    MailApp.sendEmail({
      to: to,
      subject: 'Заявка с сайта: ' + row[1] + ' — ' + row[2],
      body: [
        'Новая заявка с al-e.net',
        '',
        'Имя:      ' + row[1],
        'Телефон:  ' + row[2],
        'E-mail:   ' + (row[3] || '—'),
        'Тема:     ' + (row[4] || '—'),
        'Источник: ' + (row[6] || '—'),
        '',
        'Сообщение:',
        row[5] || '—',
        '',
        'Время: ' + row[0]
      ].join('\n')
    });
  } catch (err) {
    /* Письмо не должно ронять приём заявки: строка уже записана,
       и подтверждать доставку сайту нужно в любом случае. */
    console.error('notify failed: ' + err);
  }
}


/* Apps Script не позволяет задать HTTP-код ответа из ContentService,
   поэтому результат всегда передаётся полем ok в теле, а не статусом. */
function json(obj) {
  return ContentService
    .createTextOutput(JSON.stringify(obj))
    .setMimeType(ContentService.MimeType.JSON);
}
